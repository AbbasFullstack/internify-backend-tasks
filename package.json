{
  "name": "internify-backend-tasks",
  "version": "1.0.0",
  "description": "Internify Backend Development Internship — RESTful CRUD API, JWT authentication, and role-based access control (Node.js, Express, MongoDB, Mongoose)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/",
    "test:auth": "node --test tests/auth.test.js",
    "smoke": "node scripts/smoke-test.js",
    "smoke:auth": "node scripts/auth-smoke-test.js",
    "test:rbac": "node --test tests/rbac.test.js",
    "smoke:rbac": "node scripts/rbac-smoke-test.js",
    "make:admin": "node scripts/make-admin.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "crud",
    "rest-api",
    "internify"
  ],
  "author": "Abbas Hussain",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.0.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
