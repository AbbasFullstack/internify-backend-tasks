                ]
              }
            }
          ]
        },
        {
          "name": "5.4 Malformed id (400, not 500)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/not-an-id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs",
                "not-an-id"
              ]
            },
            "description": "Guarded before the query, so Mongoose never throws a CastError."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('the message explains why', () => pm.expect(pm.response.json().message).to.match(/not a valid blog id/));"
                ]
              }
            }
          ]
        },
        {
          "name": "5.5 Unknown id (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/66e7f1c2a4b8d9e0f1a2b3c4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs",
                "66e7f1c2a4b8d9e0f1a2b3c4"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Upload rejection",
      "item": [
        {
          "name": "6.1 A non-image is refused (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blogs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs"
              ]
            },
            "description": "Attach a .sh or .txt file here. The filter checks the extension AND the declared mimetype, so neither alone can smuggle a script through.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Script Upload Attempt",
                  "type": "text"
                },
                {
                  "key": "content",
                  "value": "A shell script must never be accepted as an image.",
                  "type": "text"
                },
                {
                  "key": "author",
                  "value": "Postman Owner",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('the message lists what is allowed', () => pm.expect(pm.response.json().message).to.match(/Unsupported/i));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "7. Image lifecycle",
      "item": [
        {
          "name": "7.1 Replace the image (old file deleted)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/{{blogId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs",
                "{{blogId}}"
              ]
            },
            "description": "Attach a second small PNG. The previous file is removed from disk only after the save succeeds.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Edited By An Administrator",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": "sample2.png"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('a new filename replaced the old one', () => pm.expect(b.data.post.image.filename).to.not.eql(pm.collectionVariables.get('imageName')));",
                  "pm.collectionVariables.set('oldImageUrl', pm.collectionVariables.get('imageUrl'));",
                  "pm.collectionVariables.set('imageUrl', b.data.post.image.url);"
                ]
              }
            }
          ]
        },
        {
          "name": "7.2 The previous image is gone",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{oldImageUrl}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{oldImageUrl}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the old file is no longer served', () => pm.expect(pm.response.code).to.eql(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "7.3 Remove the image, keep the post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/{{blogId}}/image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs",
                "{{blogId}}",
                "image"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('the image reference is cleared', () => pm.expect(b.data.post.image).to.be.undefined);",
                  "pm.test('the post itself remains', () => pm.expect(b.data.post.id).to.eql(pm.collectionVariables.get('blogId')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "8. Pagination and search",
      "item": [
        {
          "name": "8.1 Page 1 of 3",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/blogs?page=1&limit=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "3"
                }
              ]
            },
            "description": "Seed a few posts first so there is something to page through."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('three posts came back', () => pm.expect(b.data.posts.length).to.eql(3));",
                  "pm.collectionVariables.set('pageOneIds', JSON.stringify(b.data.posts.map(p => p.id)));"
                ]
              }
            }
          ]
        },
        {
          "name": "8.2 Page 2 does not repeat page 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/blogs?page=2&limit=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "2"
                },
                {
                  "key": "limit",
                  "value": "3"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const first = JSON.parse(pm.collectionVariables.get('pageOneIds') || '[]');",
                  "pm.test('no document appears on both pages', () => b.data.posts.forEach(p => pm.expect(first).to.not.include(p.id)));"
                ]
              }
            }
          ]
        },
        {
          "name": "8.3 limit is capped at 100",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/blogs?limit=9999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "9999"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('the cap was applied', () => pm.expect(pm.response.json().data.pagination.limit).to.eql(100));"
                ]
              }
            }
          ]
        },
        {
          "name": "8.4 A page past the end is empty, not an error",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/blogs?page=99&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "99"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is still 200', () => pm.response.to.have.status(200));",
                  "pm.test('zero posts', () => pm.expect(pm.response.json().data.posts.length).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "8.5 Search matches the title",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/blogs?search=blog",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "blog"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('search returned something', () => pm.expect(pm.response.json().data.posts.length).to.be.at.least(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "8.6 A wildcard is escaped, not honoured",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/blogs?search=.*",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs"
              ],
              "query": [
                {
                  "key": "search",
                  "value": ".*"
                }
              ]
            },
            "description": "Without escaping, `.*` would return the whole collection and `(` would throw a 500. Both are covered by the escape."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('no document matches the literal text', () => pm.expect(pm.response.json().data.posts.length).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "8.7 Filter by tag",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/blogs?tag=node",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs"
              ],
              "query": [
                {
                  "key": "tag",
                  "value": "node"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
