    {
      "name": "2. Create a post with an image",
      "item": [
        {
          "name": "2.1 POST /api/blogs with an image (multipart)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blogs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs"
              ]
            },
            "description": "Select any small PNG for the `image` field before sending. The response reports whether the email actually went: `notification.sent` is false when SMTP is unconfigured, and the post is still created.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Shipping a Blog with File Uploads",
                  "type": "text"
                },
                {
                  "key": "content",
                  "value": "A blog post needs a title, a body, an author and an optional image. This request proves the whole path works.",
                  "type": "text"
                },
                {
                  "key": "author",
                  "value": "Postman Owner",
                  "type": "text"
                },
                {
                  "key": "excerpt",
                  "value": "How the upload and email path works.",
                  "type": "text"
                },
                {
                  "key": "tags",
                  "value": "[\"node\",\"multer\"]",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": "sample.png"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('an image reference came back', () => pm.expect(b.data.post.image).to.be.an('object'));",
                  "pm.test('the disk path is NOT exposed', () => pm.expect(b.data.post.image.path).to.be.undefined);",
                  "pm.test('the image has a public url', () => pm.expect(b.data.post.image.url).to.match(/^\\/uploads\\/blogs\\//));",
                  "pm.test('the confirmation email was attempted', () => pm.expect(b.data.notification.sent).to.be.true);",
                  "pm.collectionVariables.set('blogId', b.data.post.id);",
                  "pm.collectionVariables.set('slug', b.data.post.slug);",
                  "pm.collectionVariables.set('imageUrl', b.data.post.image.url);",
                  "pm.collectionVariables.set('imageName', b.data.post.image.filename);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 The uploaded image is served back",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{imageUrl}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{imageUrl}}"
              ]
            },
            "description": "Proves the static /uploads mount serves the stored file."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('the response is an image', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('image/'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Owner's own posts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs",
                "mine"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('the owner sees at least their new post', () => pm.expect(b.data.posts.length).to.be.at.least(1));",
                  "pm.test('every post belongs to the owner', () => b.data.posts.forEach(p => pm.expect(p.createdBy).to.eql(pm.collectionVariables.get('ownerId'))));"
                ]
              }
            }
          ]
        }
      ],
      "description": "File upload plus the Nodemailer confirmation the task asks for."
    },
