  "item": [
    {
      "name": "1. Accounts",
      "item": [
        {
          "name": "1.1 Signup owner (role defaults to user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "description": "A fresh signup is always a regular user — the role field is not accepted from the body, so it cannot be self-assigned.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Owner\",\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('defaults to the user role', () => pm.expect(b.data.user.role).to.eql('user'));",
                  "pm.collectionVariables.set('ownerToken', b.data.token);",
                  "pm.collectionVariables.set('ownerId', b.data.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Signup a second user",
          "request": {
