{
  "info": {
    "name": "Internify Task 1 — Books CRUD API",
    "description": "Full CRUD coverage for the Books resource, plus the 400/404 error paths. Set the `baseUrl` variable, then run the whole folder or individual requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "bookId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        },
        "description": "Confirms the service is up and reports the live database state."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('database is connected', () => {",
              "  pm.expect(pm.response.json().database).to.eql('connected');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create book (201)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"genre\": \"Software Engineering\",\n  \"year\": 2008,\n  \"price\": 34.99\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/books",
          "host": ["{{baseUrl}}"],
          "path": ["api", "books"]
        },
        "description": "Creates a book. Saves the new id into the `bookId` collection variable so the following requests can use it."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "pm.test('response has an id', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.id).to.be.a('string');",
              "  pm.collectionVariables.set('bookId', body.data.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get all books (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books",
          "host": ["{{baseUrl}}"],
          "path": ["api", "books"]
        },
        "description": "Lists books with pagination metadata."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('data is an array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get all books — filtered",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books?genre=software&limit=5",
          "host": ["{{baseUrl}}"],
          "path": ["api", "books"],
          "query": [
            { "key": "genre", "value": "software" },
            { "key": "limit", "value": "5" }
          ]
        },
        "description": "Case-insensitive genre filter with a page-size limit."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get book by id (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books/{{bookId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "books", "{{bookId}}"]
        },
        "description": "Fetches a single book using the id captured by the create request."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('returns the requested book', () => {",
              "  pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('bookId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update book (200)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 29.99\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/books/{{bookId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "books", "{{bookId}}"]
        },
        "description": "Partial update — only `price` is sent, so every other field must survive."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('price was updated', () => pm.expect(pm.response.json().data.price).to.eql(29.99));",
              "pm.test('untouched author survived', () => {",
              "  pm.expect(pm.response.json().data.author).to.eql('Robert C. Martin');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete book (200)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books/{{bookId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "books", "{{bookId}}"]
        },
        "description": "Removes the book created earlier in this run."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "ERROR 400 — missing required field",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"author\": \"No Title\",\n  \"genre\": \"Drama\",\n  \"year\": 2001,\n  \"price\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/books",
          "host": ["{{baseUrl}}"],
          "path": ["api", "books"]
        },
        "description": "`title` is missing, so this must return 400 with a readable message."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', () => pm.response.to.have.status(400));",
              "pm.test('message names the missing field', () => {",
              "  pm.expect(pm.response.json().message).to.include('Title is required');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "ERROR 400 — negative price",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Bad Price\",\n  \"author\": \"Test Author\",\n  \"genre\": \"Drama\",\n  \"year\": 2001,\n  \"price\": -5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/books",
          "host": ["{{baseUrl}}"],
          "path": ["api", "books"]
        },
        "description": "Price must not be negative."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "ERROR 400 — malformed id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books/not-a-real-id",
          "host": ["{{baseUrl}}"],
          "path": ["api", "books", "not-a-real-id"]
        },
        "description": "A non-ObjectId is rejected with 400 before any query runs."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "ERROR 404 — book not found",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books/66e7f1c2a4b8d9e0f1a2b3c4",
          "host": ["{{baseUrl}}"],
          "path": ["api", "books", "66e7f1c2a4b8d9e0f1a2b3c4"]
        },
        "description": "A well-formed but unused id returns 404."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', () => pm.response.to.have.status(404));",
              "pm.test('message explains the miss', () => {",
              "  pm.expect(pm.response.json().message).to.include('No book found');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "ERROR 404 — unknown route",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/does-not-exist",
          "host": ["{{baseUrl}}"],
          "path": ["api", "does-not-exist"]
        },
        "description": "Unmatched paths reach the notFound middleware rather than hanging."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
