# ------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored and must never be committed.
# ------------------------------------------------------------------

# Port the Express server listens on
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/internify_books
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/internify_books
MONGO_URI=mongodb://127.0.0.1:27017/internify_books

# ------------------------------------------------------------------
# JWT (Task 2)
# ------------------------------------------------------------------

# Secret used to sign and verify access tokens.
# Must be at least 32 characters — the app refuses to start otherwise.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the value below in production; it is a placeholder.
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars

# How long an issued token stays valid. Accepts the `jsonwebtoken` format:
# 60s, 15m, 1h, 7d, or a plain number of seconds. Defaults to 1h when unset.
JWT_EXPIRES_IN=1h

# ------------------------------------------------------------------
# File uploads (Task 4)
# ------------------------------------------------------------------

# Where uploaded images are written. Defaults to <project>/uploads when unset.
# Must be writable by the process; it is created on boot if missing.
UPLOAD_DIR=./uploads

# Maximum accepted image size, in bytes. Defaults to 2 MB.
MAX_IMAGE_BYTES=2097152

# ------------------------------------------------------------------
# Email — Nodemailer (Task 4)
# ------------------------------------------------------------------
#
# LEAVE THESE BLANK AND THE APP STILL WORKS. With no credentials the mailer
# reports itself unconfigured, skips every send, and blog posts are still
# created — the API response says `"notification": { "sent": false }`.
#
# For Gmail you must use an App Password, not your account password:
#   Google Account -> Security -> 2-Step Verification -> App passwords
# Generate a 16-character app password and paste it into EMAIL_PASS.

EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# How long to wait on the SMTP server before giving up, in milliseconds.
# Deliberately short so a slow mail server delays a request by seconds, not
# minutes. Defaults to 8000 when unset.
SMTP_TIMEOUT_MS=8000

# ------------------------------------------------------------------
# Rate limiting (Task 4)
# ------------------------------------------------------------------
#
# Three limiters, each with its own purpose:
#   global — coarse ceiling on all traffic
#   auth   — tight, counts ONLY failed logins (successful ones are free)
#   write  — for endpoints that spend a resource, e.g. posting a blog

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

WRITE_RATE_LIMIT_WINDOW_MS=3600000
WRITE_RATE_LIMIT_MAX=30
