# ------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored and must never be committed.
# ------------------------------------------------------------------

# Port the Express server listens on
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/internify_books
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/internify_books
MONGO_URI=mongodb://127.0.0.1:27017/internify_books

# ------------------------------------------------------------------
# JWT (Task 2)
# ------------------------------------------------------------------

# Secret used to sign and verify access tokens.
# Must be at least 32 characters — the app refuses to start otherwise.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the value below in production; it is a placeholder.
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars

# How long an issued token stays valid. Accepts the `jsonwebtoken` format:
# 60s, 15m, 1h, 7d, or a plain number of seconds. Defaults to 1h when unset.
JWT_EXPIRES_IN=1h
